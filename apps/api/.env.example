REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LIBREOFFICE_PATH=soffice
# Windows example after installing LibreOffice:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# POPPLER_PATH=C:\poppler\Library\bin
IMPORT_DPI=200
USE_VISION=true
OCR_LANG=ch
SCENE_TARGET_WIDTH=794
PALETTE_K=5
EXPAND_TABLE_CELLS=true
ENABLE_SAM=false
# SAM_CHECKPOINT=/models/mobile_sam.pt
# SAM_MODEL_TYPE=vit_t
ENABLE_LAMA=false
LAMA_USE_SAM_MASK=true
# Phase 3 storage — Tencent COS (S3-compatible) or local disk
S3_ENABLED=false
# S3_ENDPOINT_URL=https://cos.ap-guangzhou.myqcloud.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=your-bucket
# S3_REGION=ap-guangzhou
# S3_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com
# S3_ADDRESSING_STYLE=virtual

# LighthouseDB (MySQL 8). Leave empty to use local SQLite at SQLITE_DB_PATH.
# DATABASE_URL=mysql://root:PASSWORD@内网IP:3306/recombyn
# SQLITE_DB_PATH=storage/recombyn.db
CORS_ORIGINS=["http://localhost:3000"]
# LLM — domestic OpenAI-compatible providers (Doubao / DeepSeek / Qwen / Moonshot)
# Prefer a single key; leave blank until you configure secrets.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional override (defaults: Doubao Ark / DeepSeek / DashScope / Moonshot)
# LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=deepseek-reasoner
# Optional per-provider keys (fallback when LLM_API_KEY is empty)
# DOUBAO_API_KEY=
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
# Doubao Ark chat — set inference endpoint id (ep-xxxx) or activated model id.
# Models only appear in the picker when these are set.
# DOUBAO_SEED_MODEL=ep-xxxx
# DOUBAO_PRO_MODEL=ep-yyyy
# Image generation (Doubao Seedream via Ark /images/generations)
# Also powers toolbar AI tools: removeBg / upscale / multiAngle / expand / vector / …
# IMAGE_DEFAULT_MODEL=doubao-seedream-4-0-250828
# Or your Ark inference endpoint id, e.g. ep-xxxx
# IMAGE_DEFAULT_MODEL=
# DOUBAO_API_KEY=   # or LLM_API_KEY — required for /api/v1/image/process
# Google Sign-In. Same Client ID in apps/web/.env as GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# Required for auth-code exchange
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console → Credentials → OAuth client:
# - Authorized JavaScript origins: http://localhost:3000
# - Authorized redirect URIs: http://localhost:3000/login/google/callback
#   (full-page redirect; current tab becomes Google login, then returns here)

# Token wallet — card keys (no WeChat/Alipay). Required before generating or redeeming keys.
CARD_KEY_SALT=change-me-to-a-long-random-string
# Xianyu shop / author contact / QR images shown in the redeem dialog
# XIANYU_SHOP_URL=https://www.goofish.com/item?id=xxxx
# AUTHOR_CONTACT=微信：your_wechat 或邮箱：you@example.com
# XIANYU_QR_URL=/qr/xianyu.png
# WECHAT_QR_URL=/qr/wechat.png

# Tencent Cloud SES — email registration verification codes
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# SES_REGION=ap-hongkong
# SES_FROM_EMAIL=noreply@your-verified-domain.com
# SES_FROM_NAME=recombyn
# Create a template in SES console with variable {{code}}, then set:
# SES_TEMPLATE_ID=100091

# Hardcoded super admin (no registration) — apps/api/api/v1/auth.py
# Email: admin@recombyn.com
# Password: Admin@2026

