REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LIBREOFFICE_PATH=soffice
# Windows example after installing LibreOffice:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# POPPLER_PATH=C:\poppler\Library\bin
IMPORT_DPI=200
USE_VISION=true
OCR_LANG=ch
SCENE_TARGET_WIDTH=794
PALETTE_K=5
EXPAND_TABLE_CELLS=true
ENABLE_SAM=false
# SAM_CHECKPOINT=/models/mobile_sam.pt
# SAM_MODEL_TYPE=vit_t
ENABLE_LAMA=false
LAMA_USE_SAM_MASK=true
# Phase 3 storage (optional)
S3_ENABLED=false
# S3_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=resume-scene
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=
# S3_ADDRESSING_STYLE=virtual
CORS_ORIGINS=["http://localhost:3000"]
# LLM — domestic OpenAI-compatible providers (Doubao / DeepSeek / Qwen / Moonshot)
# Prefer a single key; leave blank until you configure secrets.
LLM_PROVIDER=doubao
LLM_API_KEY=
# Optional override (defaults: Doubao Ark / DeepSeek / DashScope / Moonshot)
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_DEFAULT_MODEL=doubao-seed-1-6-251015
# Optional per-provider keys (fallback when LLM_API_KEY is empty)
# DOUBAO_API_KEY=
# DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
# Image generation (domestic) — not wired yet
# IMAGE_DEFAULT_MODEL=
# Google Sign-In (GIS ID token). Same Client ID in apps/web/.env as GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
