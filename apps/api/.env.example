REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
LIBREOFFICE_PATH=soffice
# Windows example after installing LibreOffice:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# POPPLER_PATH=C:\poppler\Library\bin
IMPORT_DPI=200
USE_VISION=true
OCR_LANG=ch
SCENE_TARGET_WIDTH=794
PALETTE_K=5
EXPAND_TABLE_CELLS=true
ENABLE_SAM=false
# SAM_CHECKPOINT=/models/mobile_sam.pt
# SAM_MODEL_TYPE=vit_t
ENABLE_LAMA=false
LAMA_USE_SAM_MASK=true
# Phase 3 storage — Tencent COS (S3-compatible) or local disk
S3_ENABLED=false
# S3_ENDPOINT_URL=https://cos.ap-guangzhou.myqcloud.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=your-bucket
# S3_REGION=ap-guangzhou
# S3_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com
# S3_ADDRESSING_STYLE=virtual
# S3_ACL_PUBLIC_READ=true
# Node image upload: POST /api/v1/uploads (multipart field `files`) → { items: [{ url, ... }] }

# LighthouseDB (MySQL 8). Leave empty for local SQLite at SQLITE_DB_PATH.
# Docker Compose self-host injects:
#   DATABASE_URL=mysql://recombyn:recombyn@mysql:3306/recombyn
# Host uvicorn + compose MySQL:
# DATABASE_URL=mysql://recombyn:recombyn@127.0.0.1:3306/recombyn
# DATABASE_URL=mysql://root:PASSWORD@内网IP:3306/recombyn
# SQLITE_DB_PATH=storage/recombyn.db
# Optional read replica (MySQL or Postgres)
# DATABASE_READONLY_URL=
# PostgreSQL (schema must already exist — see docs/postgres-switch.md):
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/recombyn
# SQLite concurrency
# SQLITE_WAL=true
# SQLITE_BUSY_TIMEOUT_MS=30000
# Periodic DB backups (SQLite online backup; MySQL/PG dump hint)
# DB_BACKUP_ENABLED=true
# DB_BACKUP_INTERVAL_HOURS=24
# DB_BACKUP_DIR=storage/backups
# DB_BACKUP_KEEP=14
# Design skills hot reload (poll seed JSON + data/design_skills packs)
# DESIGN_SKILLS_HOT_RELOAD=true
# DESIGN_SKILLS_HOT_RELOAD_INTERVAL_SEC=2
# BYOK AES-256-GCM key for user custom LLM credentials (32+ chars). Empty → derive from CARD_KEY_SALT (dev only).
# BYOK_AES_KEY=
# LangGraph agent short-term memory (checkpointer). Empty → same MySQL as DATABASE_URL.
# LANGGRAPH_CHECKPOINT_URL=mysql://recombyn:recombyn@127.0.0.1:3306/recombyn
# LANGGRAPH_CHECKPOINT_SQLITE_PATH=storage/langgraph_checkpoints.db
# LangGraph long-term memory Store (docs). Empty → same MySQL as DATABASE_URL.
# LANGGRAPH_STORE_URL=mysql://recombyn:recombyn@127.0.0.1:3306/recombyn
# LANGGRAPH_STORE_SQLITE_PATH=storage/langgraph_store.db
# SummarizationMiddleware (docs: short-term-memory#summarize-messages)
# AGENT_SUMMARIZE_ENABLED=true
# AGENT_SUMMARIZE_TRIGGER_TOKENS=4000
# AGENT_SUMMARIZE_KEEP_MESSAGES=20
# AGENT_SUMMARIZE_MODEL=  # empty → LLM_DEFAULT_MODEL

CORS_ORIGINS=["http://localhost:3000"]
# LLM — OpenAI-compatible providers (Doubao / DeepSeek / OpenRouter / …)
# Prefer per-provider keys for multi-provider catalogs; LLM_API_KEY is a fallback.
LLM_PROVIDER=deepseek
LLM_API_KEY=
# Optional override for unknown providers only (known providers use built-in bases)
# LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL=doubao-seed-2-0-mini
# Optional per-provider keys
# DOUBAO_API_KEY=   # Volcengine Ark — unlocks Ark DeepSeek / Doubao Seed / Seedream catalog
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# OPENROUTER_API_KEY=sk-or-v1-...   # chat/agent via https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=recombyn
# Region gate — OpenRouter is unreachable on many CN networks. Block by country:
# OPENROUTER_BLOCK_COUNTRIES=CN
# GeoLite2-Country.mmdb (MaxMind). Optional if CDN sets CF-IPCountry / similar.
# GEOLITE2_COUNTRY_DB=storage/GeoLite2-Country.mmdb
# Force country for local tests (empty = detect from headers / GeoLite2):
# CLIENT_COUNTRY_OVERRIDE=CN
# QWEN_API_KEY=
# MOONSHOT_API_KEY=
# Optional: extra Ark inference endpoints (ep-xxxx) appended to the picker
# DOUBAO_SEED_MODEL=ep-xxxx
# DOUBAO_PRO_MODEL=ep-yyyy
# Image generation default (Doubao Seedream via Ark /images/generations)
# IMAGE_DEFAULT_MODEL=doubao-seedream-5-0-lite
# Or raw Ark model id / endpoint, e.g. doubao-seedream-5-0-pro-260628
# IMAGE_DEFAULT_MODEL=
# DOUBAO_API_KEY=   # or LLM_API_KEY — required for /api/v1/image/process

# Vision extras (free local): pip install -e '.[vision]'  → rembg for 抠图
# Optional OCR for editText: pip install -e '.[ocr]'
# Optional better inpaint: ENABLE_LAMA=true (+ lama deps)

# Google Sign-In. Same Client ID in apps/web/.env as GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# Required for auth-code exchange
GOOGLE_CLIENT_SECRET=
# In Google Cloud Console → Credentials → OAuth client:
# - Authorized JavaScript origins: http://localhost:3000
# - Authorized redirect URIs: http://localhost:3000/login/google/callback
#   (full-page redirect; current tab becomes Google login, then returns here)

# Token wallet — card keys (no WeChat/Alipay). Required before generating or redeeming keys.
# Generate a strong secret, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# Do NOT leave the placeholder below in production (API will refuse it).
CARD_KEY_SALT=replace-with-secrets-token-urlsafe-32
# Required to generate card keys in admin (not the login password).
CARD_KEY_OPS_PASSWORD=change-me-card-key-ops
# Xianyu shop / author contact / optional QR image URLs for the redeem dialog
# XIANYU_SHOP_URL=https://www.goofish.com/item?id=xxxx
# AUTHOR_CONTACT=微信：your_wechat 或邮箱：you@example.com
# XIANYU_QR_URL=https://example.com/xianyu-qr.png
# WECHAT_QR_URL=https://example.com/wechat-qr.png

# Self-host only: when SES is unset, print login OTP to API logs (mode=console).
# docker compose defaults this to true. Leave false/unset on Recombyn Cloud / public prod.
# AUTH_CONSOLE_LOGIN_CODE=true
# Desktop-local only (Tauri sets this): auto-login as OS user on loopback.
# DESKTOP_LOCAL_AUTO_LOGIN=true

# Tencent Cloud SES — email registration verification codes
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# SES_REGION=ap-hongkong
# SES_FROM_EMAIL=noreply@your-verified-domain.com
# SES_FROM_NAME=recombyn
# Create a template in SES console with {{username}} and {{id}}
# (link https://recombyn.com/activate/{{id}}), then set:
# SES_TEMPLATE_ID=210471
# Optional Simple fallback base (only when TemplateID unset):
# SES_ACTIVATE_BASE_URL=https://recombyn.com/activate

# Bootstrap super admin — override before any public deploy.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password
# SUPER_ADMIN_ID=user_super_admin
# Local-only fixed OTP for SUPER_ADMIN_EMAIL (gitignored .env). Never set in production.
# SUPER_ADMIN_TEST_CODE=

# AI font generator — optional zi2zi / DG-Font inference service
# POST {FONT_INFERENCE_URL}/generate  body: { charset, style_image_url?, style_image_b64?, description }
# When empty, worker uses local Pillow glyph synthesis fallback.
# FONT_INFERENCE_URL=http://127.0.0.1:8100
# FONT_INFERENCE_TIMEOUT=300
# When Redis/Celery is down, run font jobs in a background thread (dev convenience)
# FONT_SYNC_FALLBACK=true

# Canvas multiplayer (Yjs) — mint room tokens for apps/collab
# Local npm: ws://127.0.0.1:1234  ·  Compose (via web nginx): ws://localhost:3000/collab
# Public HTTPS: wss://your.domain/collab + strong COLLAB_TOKEN_SECRET
#   (see deploy/caddy/Caddyfile.example and docs/self-hosting.md § Public host checklist)
# COLLAB_TOKEN_SECRET=dev-collab-token-secret-change-me
# COLLAB_PUBLIC_WS_URL=ws://127.0.0.1:1234

