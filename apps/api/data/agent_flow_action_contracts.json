        "mode": "details",
        "source": "prompt",
        "scenes": "drawing"
      }
    },
    "prompt_vision": {
      "label": "提示词 · 看图",
      "runtime": "配置节点：need_prompts=[\"vision\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "all"
      }
    },
    "prompt_design_spec": {
      "label": "提示词 · 通用设计规范",
      "runtime": "配置节点：need_prompts=[\"design_spec\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "all"
      }
    },
    "prompt_aesthetics": {
      "label": "提示词 · 美学规则",
      "runtime": "配置节点：need_prompts=[\"aesthetics\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "all"
      }
    },
    "prompt_react": {
      "label": "提示词 · ReAct 系统",
      "runtime": "系统提示独立节点；不写在 LLM 卡片上",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "prefer": "agent.prompt.react_system"
        }
      ]
    },
    "prompt_plan": {
      "label": "提示词 · Plan 系统",
      "runtime": "短计划系统提示独立节点",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "prefer": "agent.prompt.plan_system"
        }
      ]
    },
    "prompt_ask": {
      "label": "提示词 · Ask 系统",
      "runtime": "Ask 系统提示独立节点",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "prefer": "agent.prompt.ask_system"
        }
      ]
    },
    "validate_fail": {
      "label": "校验失败分流",
      "runtime": "tool_ops 非法时按出边条件分流（反思 / 追问）",
      "rule": "outbound_edges",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.validate"
        }
      ],
      "injectPreset": {
        "mode": "none",
        "validate": [
          "validate.checklist",
          "svg_markup"
        ]
      }
    },
    "reflect": {
      "label": "反思重试",
      "runtime": "带着错误信息回到思考；次数耗尽走出边",
      "rule": "outbound_edges"
    },
    "clarify": {
      "label": "追问用户",
      "runtime": "缺项一次问齐；也承接用户主动补充/改口后的再问",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "label": "Ask 提示词",
          "prefer": "agent.prompt.ask_system"
        }
      ],
      "injectPreset": {
        "mode": "none",
        "specs": [
          "agent.prompt.ask_system"
        ]
      }
    },
    "propose": {
      "label": "提议确认",
      "runtime": "说明将改什么等确认；用户改需求则作废旧案、下一轮重想",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "label": "Ask 提示词",
          "prefer": "agent.prompt.ask_system"
        }
      ],
      "injectPreset": {
        "mode": "none",
        "specs": [
          "agent.prompt.ask_system"
        ]
      }
    },
    "action": {
      "label": "执行画布操作",
      "runtime": "由 inject + 画布工具表定义：校验并执行 tool_ops",
      "rule": "bindings",
      "bindings": [
        {
          "field": "configRef",
          "label": "画布工具表",
          "required": true,
          "prefer": "canvas_tools"
        },
        {
          "field": "inject",
          "label": "inject.validate",
          "required": true
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "canvas_tools",
        "validate": [
          "svg_markup",
          "tool_args_schema",
          "validate.checklist"
        ]
      }
    },
    "observe": {
      "label": "观察结果",
      "runtime": "等待场景回写，按出边进入校验或失败分支",
      "rule": "outbound_edges"
    },
    "verify": {
      "label": "结果校验",
      "runtime": "结构/可选美学打分，只写 verify_* / ok / retry；分支全靠出边",
      "rule": "outbound_edges"
    },
    "error": {
      "label": "错误出口",
      "runtime": "不可恢复错误收束",
      "rule": "outbound_edges"
    },
    "end": {
      "label": "流程结束",
      "runtime": "终点，无出边业务参数",
      "rule": "terminal"
    }
  },
  "kinds": {
    "prompt": {
      "label": "提示词",
      "runtime": "配置节点：在提示词 Tab 写场景/看图规则；运行时 need_prompts 按 pack 名注入",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt"
      }
    }
  },
