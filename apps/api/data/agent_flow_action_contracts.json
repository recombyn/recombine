{
  "phases": {
    "start": {
      "label": "流程入口",
      "runtime": "接收用户输入与画布上下文，无业务参数",
      "rule": "outbound_edges"
    },
    "route": {
      "label": "任务分流",
      "runtime": "结构化路由判定车道；分流规则写在本节点出边上（不是写在说明里）",
      "rule": "outbound_edges"
    },
    "mode_fork": {
      "label": "Ask / Agent 分线",
      "runtime": "按出边条件分流（如 mode=ask / short_plan_on / mode=agent）",
      "rule": "outbound_edges"
    },
    "memory": {
      "label": "注入会话记忆",
      "runtime": "由 inject 定义：mode=details + source=memory（不是因为 id 叫 memory）",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.mode/source",
          "required": true
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "memory"
      }
    },
    "plan": {
      "label": "短计划",
      "runtime": "先生成 3～5 步中文计划再进模型路由",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "label": "计划提示词",
          "required": true,
          "prefer": "agent.prompt.plan_system"
        }
      ],
      "injectPreset": {
        "mode": "none",
        "specs": [
          "agent.prompt.plan_system"
        ]
      }
    },
    "model_route": {
      "label": "模型路由",
      "runtime": "在节点内配置轻量/标准/推理/看图模型（routeConfig），再进入主思考",
      "rule": "bindings",
      "bindings": [
        {
          "field": "configRef",
          "label": "车道路由表",
          "prefer": "precheck.model_threshold"
        }
      ]
    },
    "thought": {
      "label": "Agent 主思考",
      "runtime": "ReAct：可产出 tool_ops；缺资源时走 need_* 出边。目录注入由 inject.catalogs 定义",
      "rule": "bindings",
      "bindings": [
        {
          "field": "promptKey",
          "label": "主思考提示词",
          "required": true,
          "prefer": "agent.prompt.react_system"
        },
        {
          "field": "inject",
          "label": "inject.catalogs",
          "required": true
        },
        {
          "field": "configRef",
          "label": "可用模型集合",
          "prefer": "models+routes"
        }
      ],
      "injectPreset": {
        "mode": "catalog",
        "catalogs": [
          "canvas_tools",
          "knowledge",
          "aesthetics"
        ],
        "deferDetails": true,
        "specs": [
          "agent.prompt.react_system"
        ],
        "validate": [
          "json_contract"
        ]
      }
    },
    "ask_thought": {
      "label": "Ask 主思考",
      "runtime": "未填一次问齐；用户补充/否决/改参 → 重想 → clarify 或 propose",
      "rule": "outbound_edges",
      "bindings": [
        {
          "field": "promptKey",
          "label": "Ask 提示词",
          "required": true,
          "prefer": "agent.prompt.ask_system"
        }
      ],
      "injectPreset": {
        "mode": "catalog",
        "catalogs": [
          "canvas_tools",
          "knowledge",
          "aesthetics"
        ],
        "deferDetails": true,
        "specs": [
          "agent.prompt.react_system",
          "agent.prompt.ask_system"
        ],
        "validate": [
          "json_contract"
        ]
      }
    },
    "resource_fork": {
      "label": "并行网关",
      "runtime": "批量拉取知识/提示词/美学/工具；优先跳转 resource_join，再按 mode 回 thought / ask_thought",
      "rule": "outbound_edges"
    },
    "aesthetics_details": {
      "label": "美学看图",
      "runtime": "CLIP 向量检索样本图并附图；主思考看图，不注入短评/令牌",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=aesthetics"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "aesthetics"
      }
    },
    "tool_details": {
      "label": "工具详情",
      "runtime": "配置/干跑分支；live 由并行网关 gather 注入",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=canvas_tools"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "canvas_tools"
      }
    },
    "resource_join": {
      "label": "汇聚",
      "runtime": "资源分支汇合后按 mode=agent / mode=ask 回思考",
      "rule": "outbound_edges"
    },
    "prompt_website": {
      "label": "提示词 · 网站",
      "runtime": "配置节点：正文供 need_prompts=[\"website\"] 注入，不单独跑 LLM",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "website"
      }
    },
    "prompt_mobile": {
      "label": "提示词 · 移动",
      "runtime": "配置节点：need_prompts=[\"mobile\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "mobile"
      }
    },
    "prompt_poster": {
      "label": "提示词 · 海报",
      "runtime": "配置节点：need_prompts=[\"poster\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "poster"
      }
    },
    "prompt_image": {
      "label": "提示词 · 插画",
      "runtime": "配置节点：need_prompts=[\"image\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
      "injectPreset": {
        "mode": "details",
        "source": "prompt",
        "scenes": "image"
      }
    },
    "prompt_drawing": {
      "label": "提示词 · 板绘",
      "runtime": "配置节点：need_prompts=[\"drawing\"]",
      "rule": "bindings",
      "bindings": [
        {
          "field": "inject",
          "label": "inject.source=prompt"
        }
      ],
