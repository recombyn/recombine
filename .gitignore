# dependencies
node_modules/
apps/web/node_modules/
.pnp
.pnp.js

# production
build/
apps/web/build/
apps/web/dist/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# api runtime
apps/api/storage/uploads/*
apps/api/storage/results/*
apps/api/storage/*.db
!apps/api/storage/uploads/.gitkeep
!apps/api/storage/results/.gitkeep

# testing
coverage/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
apps/api/.coverage
apps/api/htmlcov/

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Local design-agent skills (MD guides — do not publish)
apps/web/agent-skills/
!apps/web/agent-skills.example/

# typescript incremental cache (looks like garbled JSON — not source)
*.tsbuildinfo

# Config .ts is source of truth; ignore accidental emit beside them
apps/web/vite.config.js
apps/web/vite.config.d.ts
apps/web/vitest.config.js
apps/web/vitest.config.d.ts

# Never commit compiled siblings next to .ts/.tsx — Vite resolves .js before .ts
# (keep real source as TypeScript only under apps/web/src)
apps/web/src/**/*.js
apps/web/src/**/*.jsx

npm-debug.log*
yarn-debug.log*
yarn-error.log*

apps/docs/dist/
