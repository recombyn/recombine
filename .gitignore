# Local design-agent skills (MD guides — do not publish)
apps/web/agent-skills/
!apps/web/agent-skills.example/

# typescript incremental cache (looks like garbled JSON — not source)
*.tsbuildinfo

# Config .ts is source of truth; ignore accidental emit beside them
apps/web/vite.config.js
apps/web/vite.config.d.ts
apps/web/vitest.config.js
apps/web/vitest.config.d.ts

# Never commit compiled siblings next to .ts/.tsx — Vite resolves .js before .ts
# (keep real source as TypeScript only under apps/web/src)
apps/web/src/**/*.js
apps/web/src/**/*.jsx

npm-debug.log*
yarn-debug.log*
yarn-error.log*

apps/docs/dist/

# Local agent tooling / scratch — track official Design Skill packs only
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/ui_ux_pro_max/
!.agents/skills/ui_ux_pro_max/**
