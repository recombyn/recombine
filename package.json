{
  "name": "resume-scene-studio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "cd apps/api && python -m uvicorn main:app --reload --port 8000",
    "build": "npm run build --workspace=apps/web",
    "test:web": "npm run test --workspace=apps/web",
    "install:api": "cd apps/api && pip install -e ."
  }
}
