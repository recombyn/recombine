{
  "name": "recombyn",
  "version": "0.1.0",
  "private": true,
  "description": "Recombyn — canvas editor + AI Design Agent (source-available)",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/web",
    "apps/docs",
    "apps/collab"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:docs": "npm run dev --workspace=apps/docs",
    "dev:collab": "npm run dev --workspace=apps/collab",
    "build:docs": "npm run build --workspace=apps/docs",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "npm run build --workspace=apps/web",
    "test": "npm run test:web && npm run test:api",
    "test:web": "npm run test --workspace=apps/web",
    "test:web:watch": "npm run test:watch --workspace=apps/web",
    "test:web:coverage": "npm run test:coverage --workspace=apps/web",
    "test:api": "cd apps/api && python -m pytest",
    "test:api:unit": "cd apps/api && python -m pytest tests/unit_tests",
    "test:api:integration": "cd apps/api && python -m pytest tests/integration_tests",
    "test:api:coverage": "cd apps/api && python -m pytest --cov=api --cov=services --cov-report=term-missing",
    "test:e2e": "npm run test --prefix e2e",
    "install:api": "cd apps/api && pip install -e \".[dev]\""
  }
}
